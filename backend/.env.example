# SmartLearnX Backend Environment Variables
# Copy this file to .env and fill in the values

# Port for the Express server to run on
PORT=4000

# MongoDB Atlas Connection String (recommended format: mongodb+srv://<username>:<password>@cluster.mongodb.net/LMSrs?retryWrites=true&w=majority)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.ngbsaei.mongodb.net/LMSrs?retryWrites=true&w=majority

# Clerk Auth Keys
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Stripe Payment Secret Key
STRIPE_SECRET_KEY=your_stripe_secret_key

# CORS Settings (comma-separated list of allowed production frontends)
# Example: ALLOWED_ORIGINS=https://smartlearnx-frontend.vercel.app,https://smartlearnx-admin.vercel.app
ALLOWED_ORIGINS=https://smartlearnx-frontend.vercel.app,https://smartlearnx-admin.vercel.app,http://localhost:5173,http://localhost:5174

# Frontend URL (for Stripe success/cancel redirect base)
# Example: FRONTEND_URL=https://smartlearnx-frontend.vercel.app
FRONTEND_URL=https://smartlearnx-frontend.vercel.app
